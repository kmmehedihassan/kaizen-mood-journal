# Copy to .env.local and fill in what you need. Every variable is optional:
# with none set, Kaizen runs on its built-in quote library and rule-based replies.

# --- AI provider (first configured one is used; the next is tried on failure) ---
HF_API_KEY=
HF_MODEL="deepseek-ai/DeepSeek-V3-0324:together"
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
OLLAMA_HOST=
OLLAMA_MODEL="llama3.2"

# --- Database (chat persistence + your own quotes) ---
DATABASE_URL=
DIRECT_URL=

# --- Site URL (used for sitemap / social previews) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
