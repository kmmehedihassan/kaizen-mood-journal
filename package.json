{
  "name": "kaizen-mood-journal",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test tests/*.test.ts && node --conditions=react-server --import tsx --test tests/*.server-test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^15.5.29",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.0.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
